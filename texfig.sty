%% texfig.sty -- colour palette and TikZ node styles for publication figures.
%% Every style is prefixed tf so nothing collides with a journal class.
%% See README.md for the recipe and a minimal working example.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texfig}[2026/09/18 figure kit]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{graphicx}

\usetikzlibrary{positioning, calc, shapes.geometric, arrows.meta, backgrounds,
                fit, matrix, decorations.pathreplacing, shadows.blur}

% A layer below the background one, so a panel or a group box can be fitted
% around cards that are themselves drawn on the background layer.
\pgfdeclarelayer{grouping}
\pgfsetlayers{grouping,background,main}

% ---------------------------------------------------------------- palette ----
% Apple system colours: saturated accent plus a near-white tint of each.
\definecolor{appleBlue}{RGB}{0, 122, 255}
\definecolor{appleLightBlue}{RGB}{235, 245, 255}
\definecolor{appleRed}{RGB}{255, 59, 48}
\definecolor{appleLightRed}{RGB}{255, 235, 235}
\definecolor{appleGreen}{RGB}{52, 199, 89}
\definecolor{appleLightGreen}{RGB}{235, 255, 235}
\definecolor{appleGray}{RGB}{142, 142, 147}
\definecolor{appleLightGray}{RGB}{242, 242, 247}
\definecolor{appleDarkGray}{RGB}{44, 44, 46}
\definecolor{appleDark}{RGB}{28, 28, 30}
\definecolor{applePurple}{RGB}{175, 82, 222}
\definecolor{appleLightPurple}{RGB}{243, 233, 255}
\definecolor{appleOrange}{RGB}{255, 149, 0}
\definecolor{appleLightOrange}{RGB}{255, 235, 205}
\definecolor{appleTeal}{RGB}{48, 176, 199}
\definecolor{appleLightTeal}{RGB}{213, 240, 245}
\definecolor{applePink}{RGB}{255, 45, 133}
\definecolor{appleLightPink}{RGB}{255, 232, 241}

% Target width of a figure; the including document may override it.
\providecommand{\tffigwidth}{\linewidth}

% Alignment helpers, so an arrow between two nodes can be exactly horizontal or
% exactly vertical without hand-tuned coordinates.
%   \node[...] at (\tfrow{23.2}{cardPc.east}) {...};  % x 23.2, y of cardPc.east
%   \node[...] at (\tfcol{llm.south}{4.1}) {...};     % x of llm.south, y 4.1
% Declare the node you align to first; a fitted group counts, since a node
% declared inside a pgfonlayer block is available to everything after it.
\newcommand{\tfrow}[2]{#1,0 |- #2}
\newcommand{\tfcol}[2]{0,#2 -| #1}

% The two slashes that cut an arrow where a gradient is stopped.
%   \tfcutmark[appleOrange]{(5.2,0)}
\newcommand{\tfcutmark}[2][appleGray]{%
  \draw[line width=1.5pt, draw=#1]
    ($#2+(-0.20,-0.24)$) -- ++(0.20,0.48)
    ($#2+(0.04,-0.24)$)  -- ++(0.20,0.48);}

% A literal value inside a field line.
\newcommand{\tflit}[1]{\textcolor{appleBlue!55!black}{#1}}
% The darkened text tone every accent colour uses for type.
\newcommand{\tfink}[1]{#1!62!black}

% ------------------------------------------------------------ node styles ----
\tikzset{
  % Solid light grey panel grouping one column of a picture. Background layer.
  tfpanel/.style={
    rounded corners=12pt,
    fill=appleLightGray!55,
    draw=appleGray!30,
    line width=0.6pt,
    inner sep=0.40cm},
  % Same panel tinted in an accent colour.
  tfpanelc/.style={tfpanel, fill=#1!7, draw=#1!30},
  % Dashed coloured group box with its title sitting above the frame.
  % Usage: node[tfgroup={appleGreen}{Inputs}, fit=(a)(b)] {};
  tfgroup/.style 2 args={
    rounded corners=10pt,
    draw=#1!75,
    fill=#1!4,
    dash pattern=on 4pt off 3pt,
    line width=0.9pt,
    inner sep=0.32cm,
    label={[font=\small, text=#1!62!black, inner sep=3.5pt]above:#2}},
  % White rounded card, normally used with fit= around its content nodes.
  tfcard/.style={
    rounded corners=8pt,
    fill=white,
    draw=appleGray!45,
    line width=0.7pt,
    inner sep=9pt},
  % Same card tinted in an accent colour.
  tfcardc/.style={tfcard, fill=#1!8, draw=#1!55},
  % Card header, its accent-coloured variant, and the one-line gloss under it.
  tfcardtitle/.style={
    font=\small\ttfamily,
    text=appleDark,
    anchor=west,
    inner sep=0pt},
  tfcardtitlec/.style={tfcardtitle, text=#1!62!black},
  tfcardsubtitle/.style={
    font=\scriptsize\itshape,
    text=appleGray,
    anchor=west,
    inner sep=0pt},
  % One property, value or example line inside a card.
  tffield/.style={
    font=\footnotesize\ttfamily,
    text=appleDarkGray,
    anchor=west,
    inner sep=0pt},
  % Running text inside a card, for an example rather than a property.
  tfprose/.style={
    font=\scriptsize,
    text=appleDarkGray,
    anchor=north west,
    align=left,
    inner sep=0pt},
  % Pill label: 10 percent fill, matching stroke, darkened text.
  % Usage: node[tfpill={applePurple}{4.7cm}] {Name\\[1pt]{\tiny type}};
  tfpill/.style 2 args={
    rounded corners=7pt,
    fill=#1!10,
    draw=#1,
    line width=0.7pt,
    minimum width=#2,
    minimum height=0.95cm,
    align=center,
    inner sep=4pt,
    text=#1!62!black,
    font=\footnotesize\ttfamily},
  % Secondary line inside a pill: the type of the thing named above.
  tfpilltype/.style={font=\tiny\ttfamily},
  % Solid block for a processing step, heavier than a pill.
  tfblock/.style 2 args={
    rounded corners=8pt,
    fill=#1!12,
    draw=#1!75,
    line width=0.9pt,
    minimum width=#2,
    minimum height=1.25cm,
    align=center,
    inner sep=6pt,
    text=#1!55!black,
    font=\small},
  % Small solid tag, for the name of a component or a phase. Reads as a chip,
  % so it labels a panel from inside it rather than sitting above the frame.
  tftag/.style={
    rounded corners=4pt,
    fill=#1!75!black,
    text=white,
    inner xsep=6pt,
    inner ysep=3.5pt,
    font=\small},
  % Icon canvas: a tinted rounded square to draw a small glyph inside.
  tficon/.style={
    rounded corners=4pt,
    fill=#1!14,
    draw=#1!45,
    line width=0.7pt,
    minimum size=1.6cm,
    inner sep=0pt},
  % The strokes of that glyph: an outlined shape and a plain rule.
  tfglyph/.style={
    rounded corners=1.5pt,
    draw=#1!85,
    line width=1.1pt},
  tfrule/.style={draw=#1!55, line width=0.7pt},
  % Square chip of a fixed size, for a state or a step in a chain.
  tfchip/.style 2 args={
    rounded corners=6pt,
    fill=#1!12,
    draw=#1!70,
    line width=0.9pt,
    minimum size=#2,
    inner sep=3pt,
    align=center,
    text=#1!55!black,
    font=\small},
  % Round chip, for a vector or a token entering a chain.
  tfdot/.style={
    circle,
    fill=#1!10,
    draw=#1!80,
    line width=0.9pt,
    minimum size=0.85cm,
    inner sep=1pt,
    text=#1!55!black,
    font=\small},
  % Small circle carrying an operator symbol on a path.
  tfop/.style={
    circle,
    fill=white,
    draw=appleGray!70,
    line width=0.8pt,
    inner sep=1.5pt,
    text=appleDarkGray,
    font=\small},
  % Dashed outline with no fill, for something produced rather than held.
  tfghost/.style={
    rounded corners=8pt,
    fill=white,
    draw=appleGray!65,
    line width=0.9pt,
    dash pattern=on 3pt off 2.5pt,
    minimum width=1.7cm,
    minimum height=0.9cm,
    inner sep=5pt,
    text=appleDark,
    font=\small},
  % White card for a displayed equation, and a coloured callout beside it.
  tfformula/.style={
    rounded corners=10pt,
    fill=white,
    draw=appleGray!35,
    line width=0.8pt,
    inner sep=0.42cm,
    align=left},
  tfnote/.style={
    rounded corners=10pt,
    fill=#1!7,
    draw=#1!45,
    line width=0.8pt,
    inner sep=0.32cm,
    align=center,
    text=#1!62!black,
    font=\small\bfseries},
  % Title of a figure section, set above the panel it names.
  tftitle/.style={
    font=\large\bfseries,
    text=appleDark,
    anchor=south west,
    inner sep=4pt},
  % Grey gloss set underneath a panel or a group.
  tfcaption/.style={
    font=\scriptsize,
    text=appleGray,
    align=center},
  % Free-standing label in the document tone, for something named but not boxed:
  % the caption of an icon, the input or the output at the end of an arrow.
  tflabel/.style={
    font=\small,
    text=appleDarkGray,
    align=center},
  tflabelc/.style={tflabel, text=#1!62!black},
  % Arrows. tfelbow adds the corner radius an orthogonal route needs.
  tfarrow/.style={
    -{Latex[length=2.6mm,width=1.9mm]},
    line width=0.9pt,
    draw=appleGray!75,
    rounded corners=2pt},
  tfarrowc/.style={tfarrow, draw=#1},
  tfarrowdashed/.style={tfarrow, dash pattern=on 3pt off 2.2pt},
  tfarrowdashedc/.style={tfarrowdashed, draw=#1},
  tfelbow/.style={rounded corners=7pt},
  % Label riding on an arrow; the white fill keeps it legible over an edge.
  tfedgelabel/.style={
    font=\scriptsize\ttfamily,
    text=appleDarkGray,
    fill=white,
    inner sep=1.5pt,
    rounded corners=2pt},
  tfedgelabelc/.style={tfedgelabel, text=#1!62!black},
}

\endinput
