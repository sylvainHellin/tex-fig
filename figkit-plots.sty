%% figkit-plots.sty -- pgfplots styling for figkit, for the figures that carry
%% measured numbers rather than boxes and arrows. Load it instead of figkit.
%% The package holds the look of an axis; the document holds the data.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{figkit-plots}[2026/09/18 figure kit, plots]

\RequirePackage{figkit}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% An open five-pointed star as a plot mark, for the one series a figure argues
% about. It follows the colour given in mark options, like any other mark.
\pgfdeclareplotmark{fkstarmark}{%
  \node[star, star points=5, star point ratio=2.1, draw, fill=white,
        line width=1.1pt, inner sep=0pt, minimum size=10pt, anchor=center]
       at (0pt,0pt) {};}

\pgfplotsset{
  % The shared look: no frame, a thin grey rule on the axes that remain, grid
  % lines light enough to read a value against without competing with the data.
  fkaxis/.style={
    scale only axis,
    axis line style={draw=appleGray!55, line width=0.6pt},
    tick style={draw=appleGray!55, line width=0.6pt},
    grid style={draw=appleGray!25, line width=0.4pt},
    tick label style={font=\small, text=appleDarkGray},
    label style={font=\small, text=appleDarkGray},
    tick align=outside,
    clip=false},
  % Horizontal bars against a category axis, which carries no line of its own.
  fkbaraxis/.style={
    fkaxis,
    xbar,
    axis x line*=bottom,
    % the category axis carries names, not a scale, so its rule and ticks go
    axis y line*=left,
    y axis line style={draw=none},
    ytick style={draw=none},
    xmajorgrids,
    ytick=data,
    bar width=0.42cm,
    enlarge y limits=0.09,
    y tick label style={font=\small, text=appleDarkGray},
    nodes near coords,
    point meta=explicit symbolic,
    every node near coord/.append style={
      font=\small, text=appleDarkGray, anchor=west, inner sep=3pt}},
  % A value plot: both axes drawn, grid on the measured axis only.
  fkplotaxis/.style={
    fkaxis,
    axis x line*=bottom,
    axis y line*=left,
    ymajorgrids,
    log ticks with fixed point},
  % One bar series, tinted in an accent colour.
  fkbar/.style={draw=#1!60, fill=#1!14, line width=0.7pt},
  % Scatter marks: a plain point, and the one the figure is about.
  fkpoint/.style={
    only marks, mark=o, mark size=2.3pt,
    mark options={draw=#1!65, line width=0.7pt}},
  fkstar/.style={
    only marks, mark=fkstarmark,
    mark options={draw=#1}},
  % A line through the points that form the frontier, and a trend behind them.
  fkline/.style={draw=#1, line width=1pt, mark=none},
  fktrend/.style={
    draw=appleGray!55, line width=0.7pt, mark=none,
    dash pattern=on 3pt off 2.5pt},
}

\tikzset{
  % The name of a point, set beside it inside the axis.
  fkpointlabel/.style={font=\scriptsize, text=appleDarkGray, inner sep=2.5pt},
  fkpointlabelc/.style={fkpointlabel, text=#1!62!black, font=\scriptsize\bfseries},
  % The (a), (b), (c) of a multi-panel figure.
  fkpanelletter/.style={font=\large, text=appleDark, anchor=west},
}

\endinput
